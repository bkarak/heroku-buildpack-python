#!/usr/bin/env bash
#
# This script is invoked by [`bin/compile`](/).

# LuaJIT, required by the lupa module. luajit.org no longer serves release
# tarballs; Fedora's source archive keeps them under their MD5.
LUAJIT_VERSION="2.0.2"
LUAJIT_URL="https://src.fedoraproject.org/repo/pkgs/luajit/LuaJIT-$LUAJIT_VERSION.tar.gz/112dfb82548b03377fbefbba2e0e3a5b/LuaJIT-$LUAJIT_VERSION.tar.gz"
LUAJIT_SHA256="c05202974a5890e777b181908ac237625b499aece026654d7cc33607e3f46c38"
LUAJIT_PREFIX=/app/.heroku/vendor

# Syntax sugar.
source $BIN_DIR/utils

# If lupa exists within requirements, build LuaJIT into .heroku/vendor, which
# is cached between builds and on the library paths at build and run time.
if (grep -Eiq "^\s*lupa" requirements.txt) then
  if [ -f "$LUAJIT_PREFIX/lib/pkgconfig/luajit.pc" ]; then
    puts-step "Noticed lupa. Using cached LuaJIT ($LUAJIT_VERSION)."
  else
    puts-step "Noticed lupa. Building LuaJIT ($LUAJIT_VERSION)."
    LUAJIT_TMP=$(mktemp -d)
    curl -s -f -L -o "$LUAJIT_TMP/luajit.tar.gz" "$LUAJIT_URL"
    echo "$LUAJIT_SHA256  $LUAJIT_TMP/luajit.tar.gz" | sha256sum -c - > /dev/null
    tar -zxf "$LUAJIT_TMP/luajit.tar.gz" -C "$LUAJIT_TMP"
    make -C "$LUAJIT_TMP/LuaJIT-$LUAJIT_VERSION" install PREFIX="$LUAJIT_PREFIX" 2>&1 | indent
    rm -rf "$LUAJIT_TMP"
  fi
fi
